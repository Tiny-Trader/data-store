# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to local SQLite when unset)
# DATABASE_URL=postgres://user:pass@host:5432/datastore

# Parquet store root (candle/OHLCV files live here)
PARQUET_ROOT=data

# Ingestion (EOD sync via tt-connect)
DEFAULT_BROKER=zerodha
# Per-broker credentials as a JSON blob passed straight to tt-connect.
# Keys depend on the broker/auth mode; see tt-connect docs.
# TT_ZERODHA_CONFIG={"api_key":"...","access_token":"..."}
# TT_ANGELONE_CONFIG={"api_key":"...","client_id":"...","mpin":"...","totp_secret":"..."}
