{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "tiny-trader data-store",
    "description": "Read-only REST API for historical (t-1) Indian market data.\n\n**Auth:** When `API_KEY` is set on the server, protected routes require `X-API-Key` or `Authorization: Bearer <key>`. Health is public. When `API_KEY` is unset (local/dev), protected routes are open.\n\n**Candles:** Identify by `key=…` or composite fields (`exchange`, `symbol`, `instrument_type`, plus F&O fields). `interval` defaults to `day`. `start`/`end` are ISO-8601; naive datetimes are treated as Asia/Kolkata. Range caps apply (e.g. `1minute` ≤ 5 days). **Timezone offsets:** encode `+` as `%2B` in query strings (e.g. `...T00:00:00%2B05:30`); a bare `+` becomes a space and breaks parsing. Prefer Postman params (auto-encode) or `requests.get(url, params={...})`.\n\n**Chains:** Metadata only for tracked contracts with coverage on `date` (`data_start ≤ date ≤ data_end`). Options accept an optional `expiry` filter. This is the ATM ± K watchlist window, not the full exchange chain.\n\nSet collection variables `baseUrl` and `apiKey` before calling protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleDate",
      "value": "2026-07-28",
      "type": "string"
    },
    {
      "key": "niftyOptionExpiry",
      "value": "2026-08-11",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Liveness probe. No auth.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health", ""]
            },
            "description": "Returns `{\"status\":\"ok\"}`. Public even when `API_KEY` is configured."
          },
          "response": [
            {
              "name": "ok",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/health/",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "health", ""]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Candles",
      "description": "OHLCV(+OI) for one instrument. Auth required when `API_KEY` is set.\n\n**Intervals:** `1minute`, `3minute`, `5minute`, `10minute`, `15minute`, `30minute`, `60minute`, `day` (default).\n\n**Max span:** 1m→5d, 3m→15d, 5m/10m→30d, 15m→60d, 30m→90d, 60m→180d, day→5y.",
      "item": [
        {
          "name": "Index — daily by key (NIFTY)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candles/?key=NSE:NIFTY:INDEX&interval=day&start=2026-07-01T00:00:00%2B05:30&end=2026-07-29T00:00:00%2B05:30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candles", ""],
              "query": [
                {
                  "key": "key",
                  "value": "NSE:NIFTY:INDEX",
                  "description": "Canonical instrument key"
                },
                {
                  "key": "interval",
                  "value": "day",
                  "description": "Aggregation interval (default: day)"
                },
                {
                  "key": "start",
                  "value": "2026-07-01T00:00:00%2B05:30",
                  "description": "Inclusive start (ISO-8601)"
                },
                {
                  "key": "end",
                  "value": "2026-07-29T00:00:00%2B05:30",
                  "description": "Exclusive-ish end bound (must be after start)"
                }
              ]
            },
            "description": "Daily bars for the NIFTY index resolved by `key`."
          },
          "response": []
        },
        {
          "name": "Index — 1-minute by key (NIFTY)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candles/?key=NSE:NIFTY:INDEX&interval=1minute&start=2026-07-28T09:15:00%2B05:30&end=2026-07-28T15:30:00%2B05:30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candles", ""],
              "query": [
                { "key": "key", "value": "NSE:NIFTY:INDEX" },
                { "key": "interval", "value": "1minute" },
                { "key": "start", "value": "2026-07-28T09:15:00%2B05:30" },
